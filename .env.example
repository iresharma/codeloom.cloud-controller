GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me
# Optional. When empty, tokens are encrypted with a key derived from SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./data/codeloom.db
DATA_DIR=./data
# Set when the controller runs in a container and Docker bind-mounts must use the host path.
HOST_DATA_DIR=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Repository of the sandbox images. The tag is replaced with python, node, or golang.
SANDBOX_IMAGE=codeloom-sandbox:python
ENGINE_REF=main
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
ENGINE_READY_TIMEOUT=120
SOCKET_WAIT_TIMEOUT=120
