GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me
# Optional. When empty, tokens are encrypted with a key derived from SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./data/codeloom.db
DATA_DIR=./data
# Set when the controller runs in a container and Docker bind-mounts must use the host path.
HOST_DATA_DIR=
OPENROUTER_API_KEY=
# Model injected into each sandbox. The coder profile is pinned to this model in the engine.
OPENROUTER_MODEL=openai/gpt-5.6-luna
TYPESAFE_API_KEY=
# Repository of the sandbox images. The tag is replaced with python, node, or golang.
SANDBOX_IMAGE=codeloom-sandbox:python
ENGINE_REF=main
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
ENGINE_READY_TIMEOUT=120
SOCKET_WAIT_TIMEOUT=120
# Build any missing sandbox image on startup (set false to manage images yourself).
SANDBOX_BUILD_ON_STARTUP=true
# Only needed if this checkout isn't workspace/cloud-controller next to
# workspace/engine — both are found relative to that layout otherwise.
SANDBOX_DIR=
ENGINE_PATH=
